# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
.pytest_cache
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/
pip-wheel-metadata/

# ── Virtual environments ───────────────────────────────────────────────────
my_venv/
venv/
.venv/

# ── IDE / Editor ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.clineignore

# ── Build / packaging outputs ──────────────────────────────────────────────
.build/
.deb_build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.spec.bak

# SponsorScout.spec is BUILD SOURCE (PyInstaller), not an output — an older
# cleanup.txt globbed *.spec and silently deleted it.  It is tracked; do not
# re-add it here.

# ── Backup / temp files ────────────────────────────────────────────────────
*.bak
*.db
*.db-wal
*.db-shm
tmp_*.db
tmp_*.py
tmp_*.txt
cleanup.txt
sponsorscout_context_pack.md

# ── Project artefacts (regenerated by app) ────────────────────────────────
*.log
data/*.csv
data/*.json
# Bundled seed CSVs are committed resources — don't ignore them:
!data/seeds/*.csv
CODEBASE.md

# ── Tracked source that must NEVER be ignored ─────────────────────────────
# NOTE: CODEBASE.md, SponsorScout.spec, .gitattributes, .editorconfig and the
# legacy reference scanners used to be listed here, which meant a fresh clone
# had no architecture guide and no PyInstaller spec.  They are source; they
# are tracked.

# Large third-party installers cached inside the legacy reference folder are
# NOT source and are not committed.
extra_for_dev_purpose(do not delete)/*.exe

# ── Build tools (large binaries, not for git) ─────────────────────────────
windows_build_tools/
tools/


# ── OS-specific ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini